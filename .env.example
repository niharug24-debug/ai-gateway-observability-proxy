# ==============================================================================
# Enterprise AI Gateway & Token Observability Proxy - Environment Configuration
# ==============================================================================

# Server Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# Database Configuration (PostgreSQL in production, SQLite fallback for local dev)
# For local zero-setup dev: sqlite+aiosqlite:///./gateway.db
# For production Docker/Postgres: postgresql+asyncpg://gateway_user:gateway_secret_password@localhost:5432/ai_gateway_db
DATABASE_URL=sqlite+aiosqlite:///./gateway.db

# Redis Configuration (For local zero-setup dev: redis will gracefully fallback to memory if not running)
# For production Docker: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# Upstream LLM Provider Configuration
# Set your OpenAI, Azure OpenAI, or Google Gemini OpenAI-compatible API key here
UPSTREAM_OPENAI_BASE_URL=https://api.openai.com/v1
UPSTREAM_API_KEY=your-openai-or-gemini-api-key-here

# Gateway Core Features
CACHE_TTL_SECONDS=86400           # 24 hours prompt cache TTL
PII_REDACTION_ENABLED=true       # Automatically mask Emails, Credit Cards, and Phone Numbers
SIMULATE_UPSTREAM_IF_NO_KEY=true  # If true, generates realistic mock completions when no key is set (great for offline testing)

# Frontend UI Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
